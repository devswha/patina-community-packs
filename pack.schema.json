{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patina community pattern pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "language",
    "patterns",
    "compatibility",
    "author",
    "license"
  ],
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(en|ko|zh|ja)-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "language": {
      "enum": [
        "en",
        "ko",
        "zh",
        "ja"
      ]
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 120,
        "pattern": "^(en|ko|zh|ja)-community-[a-z0-9]+(-[a-z0-9]+)*\\.md$"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "maxExclusive"
      ],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "maxExclusive": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "allOf": [
        {
          "pattern": "\\S"
        }
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "allOf": [
        {
          "pattern": "\\S"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "language": {
            "const": "en"
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "pattern": "^en-"
          },
          "patterns": {
            "items": {
              "pattern": "^en-community-"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "ko"
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "pattern": "^ko-"
          },
          "patterns": {
            "items": {
              "pattern": "^ko-community-"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "zh"
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "pattern": "^zh-"
          },
          "patterns": {
            "items": {
              "pattern": "^zh-community-"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "ja"
          }
        }
      },
      "then": {
        "properties": {
          "name": {
            "pattern": "^ja-"
          },
          "patterns": {
            "items": {
              "pattern": "^ja-community-"
            }
          }
        }
      }
    }
  ],
  "$comment": "The installer additionally enforces min < maxExclusive and compatibility with the installed Patina version."
}
